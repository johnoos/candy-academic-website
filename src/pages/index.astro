---
// src/pages/index.astro  (landing page = vault page)
import VaultLayout from '../layouts/VaultLayout.astro';
import { vaultFolders } from '../data/vault.js';

export const prerender = true;

// Edit these two lines to change the page text.
const PAGE_HEADING = "My qualifications, testimonials";
const PAGE_INTRO = "My curriculum vitae, academic documents (Education and Music), and references";
---

<VaultLayout title="Document Vault">
  <h1>{PAGE_HEADING}</h1>
  <p>{PAGE_INTRO}</p>

  {vaultFolders.map((folder, i) => (
    <details class="category" open={i === 0}>
      <summary>
        <span>{folder.title}</span>
        <span class="count">{folder.files.length}</span>
      </summary>
      <div class="file-list-wrap" style="padding-left:24px;">
        <a class="category-link" href={`/${folder.dir}`}>Open this category as its own page &rarr;</a>
      </div>
      <ul class="file-list">
        {folder.files.map(file => (
          <li class="file-item">
            <a class="file-link" href={`/assets/${folder.dir}/${file.slug}`} target="_blank" rel="noopener noreferrer">
              <span class="bullet">■</span>
              <span>{file.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  ))}
</VaultLayout>
